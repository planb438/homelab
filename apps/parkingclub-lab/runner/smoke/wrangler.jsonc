{
  // tiny stand-in for the real repo, used only by CI to prove the runner works
  "name": "smoke",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [{ "pattern": "example.com", "custom_domain": true }],
  "kv_namespaces": [{ "binding": "REQUESTS", "id": "smoke" }],
  "send_email": [{ "name": "MAILER", "destination_address": "x@example.com" }],
}
